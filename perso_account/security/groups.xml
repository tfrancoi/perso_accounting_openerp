<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_perso_account">
        <field name="name">Personnal Accouting</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record model="res.groups" id="manager_group">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_perso_account" />
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('perso_account.manager_group'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('perso_account.manager_group'))]"/>
    </record>
</odoo>